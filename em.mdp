title		= 
cpp		= 			; /lib/cpp Preprocessor
include		= 			; -I../top 
define		 = 	;{-DFLEXIBLE,-DPOSRES} 
integrator	= cg	; steep,cg
emtol		= 1.0	; the maximum force < 1.0 kJ/mol
nsteps		= 1000	; Maximum number of (minimization) steps to perform
emstep		= 0.01
nstcgsteep	= 100		
nstenergy	= 	; 
nstxtcout		= 	; 
xtc_grps		= 	; 
energygrps	= 	; 
energygrp_excl	= 
nstlist		= 10	; 
ns_type		= grid	; simple, grid
rlist		= 1.5	; 
coulombtype	= Cut-off		; Cut-off,Ewald,PME
fourierspacing	= 0.12		; [0.12 nm]
rcoulomb		= 1.5		; 
epsilon_r		= 15
vdwtype		= shift
rvdw		= 1.2		; 
constraints	= none		; 
pbc		= xyz		; xyz,no,xy
periodic_molecules	=		; no,yes
DispCorr		= 		;no,EnerPres,Ener
